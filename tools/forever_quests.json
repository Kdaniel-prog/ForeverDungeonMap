  "95189": {
   "dungeon": 2999,
   "name": "Crest of Lordaeron",
   "faction": "Alliance",
   "lvl": 22,
   "req": 16,
   "start": {
    "kind": "item",
    "name": "Crest of Lordaeron",
    "itemID": 268579,
    "zone": "inside",
    "spots": [
     "Crypt by the fountain: from the entrance go south to the fountain in the spider courtyard, turn right to a crypt with a closed door. Open the door, a banshee comes out, and the crest hangs on the wall behind her.",
     "Tower to the right of Bjork's patrol area (the room with a staircase across from Bjork's courtyard): the crest lies on the floor below the stairs. A treasure chest can also spawn in this room.",
     "Behind Bjork's patrol, north-west of Bjork: on the back wall inside the small pavilion / temple building.",
     "Tower to the left of the spider courtyard near the start, just past Witherfang: climb the spiral stairs inside, and the crest is on the outside wall at the top.",
     "Tower just after The Abandoned (Market Street): climb the tower, and the crest is on the outside wall at the top (gargoyle rooftop towers)."
    ]
   },
