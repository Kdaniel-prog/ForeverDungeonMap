<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <!-- No OnEnter/OnLeave/OnMouseUp scripts here: the map canvas wires them to the mixin's
         OnMouseEnter/OnMouseLeave/OnMouseUp itself and asserts that a pin template has none
         (Blizzard_MapCanvas.lua:309 "assertion failed!"). -->
    <Frame name="ForeverDungeonMapEntrancePinTemplate" mixin="ForeverDungeonMapEntrancePinMixin" enableMouse="true" virtual="true">
        <Size x="24" y="24"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Glow" file="Interface\Buttons\UI-ActionButton-Border" alphaMode="ADD" hidden="true">
                    <Size x="56" y="56"/>
                    <Anchors><Anchor point="CENTER"/></Anchors>
                    <Color r="1" g="0.82" b="0"/>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon" setAllPoints="true"/>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="Ring" file="Interface\Common\GoldRing">
                    <Size x="30" y="30"/>
                    <Anchors><Anchor point="CENTER"/></Anchors>
                </Texture>
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture parentKey="Highlight" file="Interface\Common\portrait-ring-withbg-highlight" alphaMode="ADD">
                    <Size x="32" y="32"/>
                    <Anchors><Anchor point="CENTER"/></Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>
</Ui>
